# Copy to .env.local for local development. On Vercel, set these under
# Project → Settings → Environment Variables. Never commit real values.

# Supabase (Project Settings → API). The service role / secret key is
# server-only: do NOT prefix it with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional: email sales on every new enquiry (https://resend.com)
RESEND_API_KEY=
ENQUIRY_NOTIFY_TO=sales@manasgeotextile.com
# Must be a domain verified in Resend; onboarding@resend.dev works for testing
# but only delivers to the Resend account owner's address.
ENQUIRY_NOTIFY_FROM=Manas Website <onboarding@resend.dev>
